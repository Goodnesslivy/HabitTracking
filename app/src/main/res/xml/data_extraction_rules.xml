<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Only include preferences in cloud backups. Databases and background workers are safely skipped. -->
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Migrate app preferences seamlessly during phone-to-phone data setup transfers -->
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
